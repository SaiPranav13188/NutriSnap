# ---------------------------------------------------------------------------
# Supabase (shared by web, mobile and api)
# Project Settings -> API in the Supabase dashboard
# ---------------------------------------------------------------------------
# The PROJECT URL, with no path on the end. Supabase also shows a REST
# endpoint (.../rest/v1) — using that one makes the client build
# "/rest/v1/auth/v1/..." and auth fails with "No API key found in request".
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# SERVER ONLY. Never expose this to web/mobile clients.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# AI vision provider (services/api)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
GEMINI_VISION_MODEL=gemini-3.6-flash

# ---------------------------------------------------------------------------
# API service
# ---------------------------------------------------------------------------
PORT=8080
API_CORS_ORIGINS=http://localhost:3000,exp://127.0.0.1:8081

# ---------------------------------------------------------------------------
# Web (apps/web/.env.local) — NEXT_PUBLIC_* values are sent to the browser
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
NEXT_PUBLIC_API_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Mobile (apps/mobile/.env) — EXPO_PUBLIC_* values are bundled into the app
# Use your machine's LAN IP for the API so a physical phone can reach it.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
EXPO_PUBLIC_API_URL=http://192.168.1.10:8080
