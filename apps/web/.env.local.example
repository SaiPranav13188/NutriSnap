# Copy this file to apps/web/.env.local and fill in your own values.
# .env.local is gitignored; this example file is not — keep real keys out of it.

# The PROJECT URL, with no path on the end.
# Supabase dashboard → Project Settings → Data API → Project URL.
# Not the REST endpoint: a trailing "/rest/v1" makes the client build
# "/rest/v1/auth/v1/..." and auth fails with "No API key found in request".
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

NEXT_PUBLIC_API_URL=http://localhost:8080

# Social logins to show on the sign-in page. Leave blank (the default) unless
# you have actually enabled the provider in Supabase -> Authentication ->
# Sign In / Providers. An unconfigured provider redirects to a raw JSON error
# page that cannot be caught by the app.
# Example once Google is configured:  NEXT_PUBLIC_OAUTH_PROVIDERS=google
NEXT_PUBLIC_OAUTH_PROVIDERS=
