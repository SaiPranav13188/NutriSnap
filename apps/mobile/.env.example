EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Use your machine's LAN IP, not localhost — a physical phone cannot reach
# your laptop's loopback address.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8080

# Social logins to show. Leave blank until the provider is actually enabled
# in Supabase -> Authentication -> Sign In / Providers.
# Once Google is configured:  EXPO_PUBLIC_OAUTH_PROVIDERS=google
EXPO_PUBLIC_OAUTH_PROVIDERS=
